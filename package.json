{
  "name": "vscode-transpile-panel",
  "displayName": "Transpile Panel",
  "description": "Live, source-anchored cross-language code projection beside the active VS Code editor",
  "version": "1.2.0",
  "publisher": "smartcavebot",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartcavebot/vscode-transpile-panel"
  },
  "homepage": "https://github.com/smartcavebot/vscode-transpile-panel#readme",
  "bugs": {
    "url": "https://github.com/smartcavebot/vscode-transpile-panel/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "transpile",
    "translation",
    "projection",
    "code",
    "side-by-side"
  ],
  "activationEvents": [
    "onCommand:transpilePanel.open",
    "onCommand:transpilePanel.refresh"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "transpilePanel.open",
        "title": "Transpile Panel: Open Projection",
        "icon": {
          "light": "resources/icons/translate-light.svg",
          "dark": "resources/icons/translate-dark.svg"
        }
      },
      {
        "command": "transpilePanel.refresh",
        "title": "Transpile Panel: Refresh Projection"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "transpilePanel.open",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Transpile Panel",
      "properties": {
        "transpilePanel.targetLanguage": {
          "type": "string",
          "default": "python",
          "description": "VS Code language identifier for the target projection (for example python, typescript, rust)."
        },
        "transpilePanel.pairingMode": {
          "type": "string",
          "enum": [
            "pinned",
            "followActive"
          ],
          "default": "pinned",
          "description": "Keep the projection paired to its source editor, or follow later active source editors."
        },
        "transpilePanel.refreshMode": {
          "type": "string",
          "enum": [
            "manual",
            "debounced"
          ],
          "default": "debounced",
          "description": "When provider work is started after edits. Source invalidation/rebasing always happens immediately."
        },
        "transpilePanel.debounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "maximum": 10000,
          "description": "Quiet period before a debounced projection refresh."
        },
        "transpilePanel.contextLines": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum surrounding source lines considered when building provider context around the exact projection focus."
        },
        "transpilePanel.maxContextCharacters": {
          "type": "number",
          "default": 12000,
          "minimum": 2,
          "maximum": 1000000,
          "description": "Hard character cap for source context sent to a projection provider. The exact focus must fit within this bound; the two-character minimum preserves CRLF as an atomic text boundary."
        },
        "transpilePanel.coverageChunkLines": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum source lines owned by one bounded coverage-fill request."
        },
        "transpilePanel.coverageChunkCharacters": {
          "type": "number",
          "default": 6000,
          "minimum": 2,
          "maximum": 1000000,
          "description": "Hard character cap for one coverage focus, including minified or single-line source files. The two-character minimum preserves CRLF as an atomic text boundary."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package:prod",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "check:host-neutral": "node scripts/check-core-host-neutral.js",
    "test:core": "node scripts/run-core-tests.js",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package:prod": "npm run check-types && node esbuild.js --production",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1"
  }
}
