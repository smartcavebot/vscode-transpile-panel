{
  "name": "vscode-translate-panel",
  "displayName": "Translate Panel",
  "description": "Real-time translation preview panel for any text-based file",
  "version": "1.1.0",
  "publisher": "iyulab",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/vscode-translate-panel"
  },
  "homepage": "https://github.com/iyulab/vscode-translate-panel#readme",
  "bugs": {
    "url": "https://github.com/iyulab/vscode-translate-panel/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "translate",
    "translation",
    "preview",
    "i18n",
    "localization",
    "google translate",
    "gemini",
    "comments"
  ],
  "activationEvents": [
    "onCommand:translatePanel.openPreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "translatePanel.openPreview",
        "title": "Translate Panel: Open Preview",
        "icon": {
          "light": "resources/icons/translate-light.svg",
          "dark": "resources/icons/translate-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "translatePanel.openPreview",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Translate Panel",
      "properties": {
        "translatePanel.targetLanguage": {
          "type": "string",
          "default": "",
          "description": "Target language code (e.g., ko, en, ja, es, zh). Leave empty to use system language."
        },
        "translatePanel.translationEngine": {
          "type": "string",
          "enum": [
            "google",
            "gemini"
          ],
          "default": "google",
          "description": "Translation engine to use"
        },
        "translatePanel.updateMode": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "default": "onSave",
          "description": "When to update translation"
        },
        "translatePanel.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Gemini API key (required for Gemini engine)"
        },
        "translatePanel.debounceDelay": {
          "type": "number",
          "default": 500,
          "description": "Debounce delay in milliseconds for onType mode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package:prod",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package:prod": "npm run check-types && node esbuild.js --production",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1"
  }
}
